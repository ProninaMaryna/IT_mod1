flowchart TD
    A((●)) --> B[Тригер: кнопка,<br/>зміна в папці або таймер]
    B --> C{Папка обрана і цикл<br/>не виконується?}
    C -- ні --> Z((◉))
    C -- так --> D[Сканувати папку,<br/>отримати список з сервера<br/>і базовий стан]
    D --> G[plan_sync:<br/>local, remote, base]
    G --> H{Є ще дії?}
    H -- ні --> S[Зберегти базовий стан,<br/>оновити журнал і таблицю]
    S --> Z
    H -- так --> I{Тип дії}
    I -- upload --> J1[POST<br/>/api/files]
    I -- download --> J2[Завантажити<br/>й записати]
    I -- delete_remote --> J3[DELETE<br/>на сервері]
    I -- delete_local --> J4[Видалити<br/>локально]
    I -- conflict --> J5[Зберегти обидві<br/>версії]
    J1 --> K{Помилка?}
    J2 --> K
    J3 --> K
    J4 --> K
    J5 --> K
    K -- так --> K2[Додати в errors]
    K2 --> H
    K -- ні --> H
